#!/bin/sh
# Zero-dependency staged-file gate: node --check for JS, eslint (if present)
# for the frontend tree. Kept dependency-free on purpose (AGENTS.md).
# Checks the STAGED blob, not the worktree copy: `git add` a broken file then
# fixing the worktree must not slip the broken blob through.
staged_js=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.m?js$' || true)
[ -z "$staged_js" ] && exit 0
fail=0
tmp=$(mktemp)
trap 'rm -f "$tmp"' EXIT
for f in $staged_js; do
  git show ":$f" > "$tmp" 2>/dev/null || { echo "pre-commit: cannot read staged blob: $f" >&2; fail=1; continue; }
  case "$f" in
    TDEase-FrontEnd/*)
      (cd TDEase-FrontEnd && npx --no-install eslint --stdin --stdin-filename "../$f" < "$tmp" >/dev/null 2>&1) || {
        echo "pre-commit: eslint failed: $f (run 'pnpm run lint' in TDEase-FrontEnd)" >&2
        fail=1
      }
      ;;
    *)
      node --check "$tmp" 2>/dev/null || { echo "pre-commit: node --check failed: $f" >&2; fail=1; }
      ;;
  esac
done
exit $fail
