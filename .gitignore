__pycache__/
.venv/
*.pyc
*.egg-info/
dist/
build/
# Backend runtime data and node binaries stay out of git. Backend owns its node
# catalog at data/backend/nodes; Desktop/System is a separate layer.
# The practice-built definition layer (rules.smk, READMEs, wrappers) and the
# definition-only nodes (pride, topindex) ARE tracked — a data/ wipe must not
# lose them again (recovered 2026-08-31 from the 2026-07-28 desktop deploy).
data/backend/*
!data/backend/nodes/
data/backend/nodes/*
!data/backend/nodes/README.md
!data/backend/nodes/pride/
!data/backend/nodes/topindex/
!data/backend/nodes/toppic/
data/backend/nodes/toppic/*
!data/backend/nodes/toppic/rules.smk
!data/backend/nodes/toppic/README.md
!data/backend/nodes/toppic/resources/common_variable_ptms.txt
!data/backend/nodes/toppic21/
data/backend/nodes/toppic21/*
!data/backend/nodes/toppic21/rules.smk
!data/backend/nodes/toppic21/README.md
!data/backend/nodes/msconvert/
data/backend/nodes/msconvert/*
!data/backend/nodes/msconvert/rules.smk
!data/backend/nodes/msconvert/README.md
# Copyable node template (external tool by absolute path). `_`-prefixed
# directories are skipped by the catalog scanner, so the template is deployed
# with the seed but never appears as a node.
!data/backend/nodes/_template/
data/backend/nodes/_template/*
!data/backend/nodes/_template/rules.smk
!data/backend/nodes/_template/README.md
!data/backend/nodes/informed-proteomics/
data/backend/nodes/informed-proteomics/*
!data/backend/nodes/informed-proteomics/rules.smk
!data/backend/nodes/informed-proteomics/README.md
# Suite-authored text artifacts + TDEase-curated mods library (source artifacts;
# the binaries/DLLs next to them stay ignored).
!data/backend/nodes/informed-proteomics/Example_Files/
data/backend/nodes/informed-proteomics/Example_Files/*
!data/backend/nodes/informed-proteomics/Example_Files/*.txt
!data/backend/nodes/informed-proteomics/resources/
data/backend/nodes/informed-proteomics/resources/*
!data/backend/nodes/informed-proteomics/resources/*.txt
# Dev-time junction: data/system -> tdease-ai-capability/system (assembled by the
# host at startup; the real assets live in the capability submodule).
data/system/
logs/
tmp/
# Session scratch (probes, pytest variants, ad-hoc scripts) — never enters git.
.tmp/
.env
*.bak
uv.lock
.scratch/
.firecrawl/
.codex/
.pi/
.zcode/
.impeccable/
.pytest_cache/
.ruff_cache/
openhanako-main/
hermes/
node_modules/
evals/
*.sqlite-shm
*.sqlite-wal
tools/**/__pycache__/
TDEase-FrontEnd/test-results/
.playwright-mcp/
# Playwright CLI session artifacts (pages/screenshots).
.playwright-cli/
TDEase-FrontEnd/auto-imports.d.ts
TDEase-FrontEnd/components.d.ts
TDEase-FrontEnd/*.log
# The wasm demo crate was removed with the nodejs-wasm delivery path (2026-08-04).
TDEase-FrontEnd/electron/mass-spec-demo/
# SQLite transient sidecars (knowledge.db, unimod.sqlite, psimod.sqlite).
*.db-shm
*.db-wal
# Agent session working files (planning-with-files style) are per-session
# scratch: their durable conclusions belong in docs/STATUS.md or docs/design/,
# never at the repo root.
/findings.md
/progress.md
/task_plan.md
# Local planning/investigation scratch dirs.
.planning/
# test-agent-runtime session scratch (manual loops, regressions, probes).
.agents/skills/test-agent-runtime/scratch/
# Claude Code local state.
.claude/plans/
.claude/settings.local.json
.omp/
data/workspace/.tdease
*.raw
data/workspace
# 22 GB workspace backup used for the 2026-08-28 restore — never enters git.
data/workspace.zip
# Paper package is temporary side work — versioned in its own repository
# (docs/paper/.git, seeded from this repo's history via subtree split).
docs/paper/
# TypeScript incremental-build artifacts (regenerated by tsc/vue-tsc).
*.tsbuildinfo
# Office owner-lock files (~$foo.docx) created while a doc is open in Word.
~$*
*.log
*.jsonl
# Trellis task manifests are curated context lists loaded by sub-agent hooks —
# they must stay tracked despite the blanket *.jsonl above.
!.trellis/**/*.jsonl
Kimi_Agent_TDEase 品牌动画/

reference/
软件著作权申请资料/
# Evolver (evomap) runtime: bridged transcripts for experience ingest live here.
.evolver/
.agents/skills/
data/.tdease/
data/archive/
# Archived experiment shells (former Tauri port of TDEase-FrontEnd) — never tracked here.
# Anchored to repo root: a bare `archive/` also ignores .trellis/tasks/archive/,
# which Trellis needs tracked for finished-task archives.
/archive/
# Release 2026-09: private material lives outside the repo (../TDEase-private) —
# paper figures, launch-trailer drafts, machine-config backups, provider search
# drafts. None of it re-enters git.
/results/
/trailer/
/TDEase-paper-*.zip
/search-*.json
.claude/
/release/
TDEase-FrontEnd/release/

# AI/dev-session artifacts
.archify/
.pnpm-store/
